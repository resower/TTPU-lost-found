# Copy this file to .env and fill it in. Never commit the real .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed once the site is on a real domain, e.g. https://lostfound.example.com
CSRF_TRUSTED_ORIGINS=

# Telegram (create a TEST bot and a TEST office group for development)
BOT_TOKEN=
# Numeric chat id of the office group, e.g. -1001234567890
OFFICE_GROUP_ID=
# Room number shown to students in the "come to the office" message
OFFICE_ROOM=104
